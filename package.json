{
  "name": "pdf-text-extract",
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unicorn": "^64.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.8.21",
    "typescript-eslint": "^8.57.2"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:backend": "pnpm --filter backend run dev",
    "dev:frontend": "pnpm --filter frontend run dev",
    "build": "turbo build",
    "build:backend": "pnpm --filter backend run build",
    "build:frontend": "pnpm --filter frontend run build",
    "test": "turbo test",
    "test:backend": "pnpm --filter backend run test",
    "lint": "turbo lint",
    "lint:backend": "pnpm --filter backend run lint",
    "lint:frontend": "pnpm --filter frontend run lint",
    "format": "turbo format",
    "format:backend": "pnpm --filter backend run format",
    "format:frontend": "pnpm --filter frontend run format",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,md,yml,yaml}": "prettier --write",
    "backend/**/*.{ts,tsx}": "pnpm --filter backend exec eslint --fix",
    "frontend/**/*.{ts,tsx}": "pnpm --filter frontend exec eslint --fix"
  },
  "packageManager": "pnpm@10.25.0"
}
